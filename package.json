{
  "name": "fichior",
  "version": "1.2.0",
  "description": "Premium File Manager with Natural Language Search, Smart Folders, Local Versioning, and Watchdog automation",
  "main": "server.js",
  "electronMain": "electron-main.cjs",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron electron-main.cjs",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.fichior.app",
    "productName": "Fichior",
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "server.js",
      "db.js",
      "indexer.js",
      "natural_language.js",
      "versions.js",
      "watchdog.js",
      "package.json",
      "fichior_icon.png"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "archiver": "^6.0.2",
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "dropbox": "^10.0.0",
    "exif-parser": "^0.1.12",
    "express": "^4.19.2",
    "googleapis": "^173.0.0",
    "mammoth": "^1.7.2",
    "mime-types": "^2.1.35",
    "multer": "^2.1.1",
    "music-metadata": "^7.14.0",
    "pdf-parse": "^1.1.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.2.11"
  }
}
